# =====================================================================
# PM SHOW — Frontend (Next.js BFF)
# Copy to `.env.local`. In production set these on Vercel.
# No variable here is NEXT_PUBLIC: they all stay on the server.
# =====================================================================

# NestJS backend URL (server-to-server; GraphQL lives at /graphql)
BACKEND_URL=http://localhost:4000

# Only for `next dev`: comma-separated hosts allowed to use the dev server,
# e.g. the notebook's Wi-Fi IP to test on a phone (192.168.0.10).
DEV_ALLOWED_ORIGINS=

# Same key as the backend's INTERNAL_API_KEY
INTERNAL_API_KEY=

# Origin of the audio storage (the backend's AWS_ENDPOINT_URL_S3), allowed by
# the Content-Security-Policy for playback and uploads. Empty = audio blocked.
MEDIA_ORIGIN=

# Session cookie name (httpOnly)
SESSION_COOKIE_NAME=pms_session

# Time zone used to display dates
APP_TIMEZONE=America/Sao_Paulo

# Public address of the app (links in e-mails). On Vercel, without this
# variable, the project's production domain is used.
SITE_URL=http://localhost:3000
