# =====================================================================
# PM SHOW — Frontend (Next.js BFF)
# Copie para `.env.local`. Em produção configure na Vercel.
# Nenhuma variável aqui é NEXT_PUBLIC: todas ficam só no servidor.
# =====================================================================

# URL do backend NestJS (server-to-server; o GraphQL fica em /graphql)
BACKEND_URL=http://localhost:4000

# Mesma chave do backend (INTERNAL_API_KEY)
INTERNAL_API_KEY=

# Nome do cookie de sessão (httpOnly)
SESSION_COOKIE_NAME=pms_session

# Fuso usado para exibir datas
APP_TIMEZONE=America/Sao_Paulo

# Endereço público do app (links nos e-mails). Na Vercel, sem esta variável,
# usa o domínio de produção do projeto.
SITE_URL=http://localhost:3000
